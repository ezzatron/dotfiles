#!/usr/bin/env bash
set -e
set -o pipefail

machine_id="$(./bin/mac-serial-hash)"
no_switch=false

usage() {
  echo "Usage: update [OPTIONS]"
  echo
  echo "Updates all flake inputs and optionally applies them."
  echo
  echo "Options:"
  echo "  --no-switch     Update flake.lock but don't run darwin-rebuild switch"
  echo "  --help          Show this help"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-switch) no_switch=true; shift ;;
    --help) usage; exit 0 ;;
    -*) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
    *) echo "Unknown argument: $1" >&2; usage >&2; exit 1 ;;
  esac
done

# Authenticate GitHub API requests using the GitHub CLI's token, if available.
# This avoids the low unauthenticated API rate limit without storing any
# credentials in the repo or the Nix configuration.
if command -v gh >/dev/null 2>&1 && gh_token="$(gh auth token 2>/dev/null)" && [[ -n "$gh_token" ]]; then
  if [[ -n "$NIX_CONFIG" ]]; then
    NIX_CONFIG+=$'\n'
  fi
  NIX_CONFIG+="access-tokens = github.com=${gh_token}"
  export NIX_CONFIG
fi

# Keep a backup so lock changes can be reverted on failure.
cp flake.lock flake.lock.bak
restore_lock_on_error() {
  local exit_code="$1"
  if [[ "$exit_code" -ne 0 && -f flake.lock.bak ]]; then
    mv flake.lock.bak flake.lock
  else
    rm -f flake.lock.bak
  fi
}
trap 'restore_lock_on_error "$?"' EXIT

echo "Updating flake inputs..."
nix flake update

if diff -q flake.lock flake.lock.bak &>/dev/null; then
  echo
  echo "No changes to flake.lock."
  exit 0
fi

if [[ "$no_switch" == true ]]; then
  echo
  echo "flake.lock updated. Run 'darwin-rebuild switch --flake \".#${machine_id}\"' to apply."
else
  echo
  echo "Switching to updated configuration..."
  sudo darwin-rebuild switch --flake ".#${machine_id}"
fi
