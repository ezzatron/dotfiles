#!/usr/bin/env bash
set -e
set -o pipefail

export REPO="ezzatron/dotfiles"
export BRANCH="nix"

# Prompt immediately for sudo, and keep it alive while the install script runs
sudo -v
while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done &>/dev/null &

if [[ -f install && -f flake.nix ]]; then
  echo "Running locally, skipping download."
else
  echo "Downloading dotfiles..."
  dir=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles.XXXXXXXXX")
  trap 'rm -rf -- "$dir"' EXIT
  cd "$dir"
  curl \
    --fail \
    --silent \
    --show-error \
    --location \
    --output dotfiles.zip \
    "https://github.com/${REPO}/archive/refs/heads/${BRANCH}.zip"
  unzip -q dotfiles.zip
  cd "dotfiles-${BRANCH}"
  echo "Dotfiles downloaded."
fi

if [[ "$(uname -p)" == "arm" ]]; then
  if [[ -f /Library/Apple/usr/share/rosetta/rosetta ]]; then
    echo "Rosetta is already installed."
  else
    echo "Installing Rosetta..."
    sudo softwareupdate --install-rosetta --agree-to-license
  fi
fi

if [ -d "/Library/Developer/CommandLineTools" ]; then
    echo "Xcode Command Line Tools are already installed."
else
  echo "Installing Xcode Command Line Tools..."
  xcode-select --install
  while [ ! -d "/Library/Developer/CommandLineTools" ]; do
    sleep 1
  done
  echo "Xcode Command Line Tools installed."
fi

# Install Lix with flakes
if [ -e /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]; then
    echo "Lix is already installed."
    source "/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh"
else
    echo "Installing Lix..."
    curl -sSf -L https://install.lix.systems/lix \
        | NIX_INSTALLER_ENABLE_FLAKES=true sh -s -- install --no-confirm
    source "/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh"
    echo "Lix installed."
fi

# Switch to the flake for this machine
# Using a temporary home directory fixes "warning: $HOME is not owned by you"
sudo mkdir -p /tmp/nix-home
HOME=/tmp/nix-home sudo nix run nix-darwin/master#darwin-rebuild -- switch --flake ".#$(./bin/mac-serial-hash)"
