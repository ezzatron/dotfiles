#!/usr/bin/env bash
set -e
set -o pipefail

until [ -e "$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock" ]
do
  echo "Add your personal 1Password account to the app, then enable the following options in the preferences:"
  echo
  echo "  - Developer > 1Password SSH Agent > Use the SSH agent"
  echo "  - Developer > Command-Line Interface (CLI) > Connect with 1Password CLI"
  echo
  read -p "Press enter to open 1Password..."
  open /Applications/1Password.app
  read -p "Press enter to continue..."
done
echo "1Password SSH agent running."

until op account get --account my &>/dev/null
do
    echo "1Password CLI session not detected."
    echo "Signing in to 1Password CLI..."
    eval $(op signin --account=my)
done
echo "1Password CLI authenticated."

echo "Installing asdf plugins..."
asdf plugin add nodejs https://github.com/asdf-vm/asdf-nodejs.git

echo "Change Chrome settings:"
echo
echo "  - Set as the default browser"
echo '  - Chrome > Uncheck "Warn Before Quitting"'
echo "  - chrome://settings/content/federatedIdentityApi > Block sign-in prompts from identity services"
echo "  - chrome://flags/#hardware-media-key-handling > Disabled"
echo "  - chrome://extensions/?id=dhdgffkkebhmkfjojejmpbldmpobfkfo > Allow user scripts"
echo "  - Install https://gist.github.com/ezzatron/a17ddc0ce4cbdf1f37aeaf6acc95af7a"
echo "  - Configure 1Password extension to only fill from the Personal vault"
echo
read -p "Press enter to open Chrome..."
open -a "Google Chrome"
read -p "Press enter to continue..."

until gh auth status &>/dev/null; do
  echo "Authenticating GitHub CLI..."
  gh auth login --hostname=github.com --git-protocol=ssh --skip-ssh-key --web
done
echo "GitHub CLI authenticated."

echo "Installing GitHub CLI extensions..."
gh extension install --force github/gh-copilot

until fdesetup status | grep -q "FileVault is On" ; do
  echo "Enable FileVault in the System Preferences."
  open "x-apple.systempreferences:com.apple.preference.security?FileVault"
  read -p "Press enter to continue..."
done

echo "Adjust screen brightness:"
echo
echo '  - Disable "Automatically adjust brightness'
echo '  - Adjust brightness manually using the slider'
echo
read -p "Press enter to open System Settings - Displays..."
open "x-apple.systempreferences:com.apple.preference.displays"
read -p "Press enter to continue..."

echo "Bind caps lock to escape for both internal and external keyboards:"
echo
echo "  - Keyboard Shortcuts... > Modifier Keys > Select keyboard > Caps Lock > Escape"
echo
read -p "Press enter to open System Settings - Keyboard..."
open "x-apple.systempreferences:com.apple.preference.keyboard"
read -p "Press enter to continue..."

echo "Add internet accounts:"
read -p "Press enter to open System Settings - Internet Accounts..."
open "/System/Library/PreferencePanes/InternetAccounts.prefPane"
read -p "Press enter to continue..."

echo "Change Screenshots folder view settings:"
echo
echo "  - View > Use Groups"
echo "  - View > Group By > Date Created"
echo
read -p "Press enter to open Screenshots directory..."
open "$HOME/Screenshots"
read -p "Press enter to continue..."

echo "Change Safari settings:"
echo
echo "  - Safari > Settings:"
echo "    - Extensions > 1Password for Safari > Allow in Private Browsing"
echo "    - Advanced > Show features for web developers"
echo
read -p "Press enter to open Safari..."
open -a "Safari"
read -p "Press enter to continue..."

echo "Change Mail settings:"
echo
echo " - Favourites (+ button):"
echo "   - All Inboxes"
echo "   - All Archive"
echo "   - All Sent"
echo "   - All Junk"
read -p "Press enter to open Mail..."
open -a "Mail"
read -p "Press enter to continue..."

echo "Change Music settings:"
echo
echo "  - Set Music playlists to download"
echo "  - Controls > Shuffle > Albums"
echo
read -p "Press enter to open Music..."
open -a "Music"
read -p "Press enter to continue..."

echo "Opening default applications..."
open -a "1Password"
open -a "AlDente"
open -a "Calendar"
open -a "ChatGPT"
open -a "Docker"
open -a "Google Chrome"
open -a "iTerm"
open -a "Mail"
open -a "Messages"
open -a "Music"
open -a "Scroll Reverser"
open -a "Slack"
open -a "Visual Studio Code"
